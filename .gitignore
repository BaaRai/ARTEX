# docs
/docs/

# os
.DS_Store
Thumbs.db

# claude code local state
.claude/

# single-binary artifact with embedded frontend
/artex
# intermediate artifacts left next to the executable by one-click update (staging file / backup / failed version / upgrade marker)
/artex.new
/artex.new.sha256
/artex.old
/artex.failed
/artex.upgrade.json
/server/webui/dist/
/dist/

# JWT signing key (generated at runtime, stored in the project root, never committed)
/jwt.key

# local environment generated by Docker deployment (contains passwords/keys, not committed)
.env

# event logs produced by scheduler runs/simulations (test artifacts, not committed)
*-events.csv

# bench benchmark related (local artifacts, not committed)
/bench/
/Dockerfile.bench
/Dockerfile.bench.v2backups/

# benchmark runner output (one dir per run)
benchmark-results/
